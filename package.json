{
  "name": "eureka-and-beyond",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Eureka and Beyond — free, interactive STEM learning platform. Discover. Understand. Go Beyond.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "mkdir -p dist && wrangler pages dev --port 8787",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler pages dev --port 8787",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply eureka-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply eureka-db --remote",
    "db:backup:remote": "wrangler d1 export eureka-db --remote --output=backups/eureka-$(date +%Y%m%d-%H%M%S).sql",
    "deploy": "npm run build && wrangler pages deploy --project-name eureka-and-beyond --branch main",
    "dev:web": "vite",
    "deploy:prod": "bash scripts/deploy.sh production",
    "content:build": "node scripts/build-content.ts",
    "content:check": "node scripts/build-content.ts --check",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs",
    "deploy:staging": "bash scripts/deploy.sh staging"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "hono": "^4.13.19",
    "katex": "^0.19.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
