{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eureka and Beyond",
  "version": "1.0.0",
  "identifier": "dev.eurekaandbeyond.desktop",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "title": "Eureka and Beyond",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Free interactive mathematics, physics and chemistry",
    "longDescription": "Eureka and Beyond: lessons, simulations and practice for mathematics, physics and chemistry, from algebra readiness to AP.",
    "copyright": "Eureka and Beyond",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
